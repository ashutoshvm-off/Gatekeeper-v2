# Server-only secrets. Copy this file to .env.server and fill in the values.
# Do not put tokens/passwords in VITE_* variables or frontend code.
GATEKEEPER_DATABASE=turso
TURSO_DATABASE_URL=replace-with-your-libsql-database-url
TURSO_AUTH_TOKEN=replace-with-your-database-token
GATEKEEPER_GUARD_PASSWORD=replace-with-a-password-of-at-least-12-characters
GATEKEEPER_ADMIN_PASSWORD=replace-with-a-different-password-of-at-least-12-characters
